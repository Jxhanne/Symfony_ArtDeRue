{% extends 'base.html.twig' %}

{% block title %}Oeuvre{% endblock %}

{% block body %}
    <h1>Oeuvre</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ oeuvre.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ oeuvre.titre }}</td>
            </tr>
            <tr>
                <th>DateCreation</th>
                <td>{{ oeuvre.dateCreation ? oeuvre.dateCreation|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ oeuvre.description }}</td>
            </tr>
            <tr>
                <th>EstDetruit</th>
                <td>{{ oeuvre.estDetruit ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <h2>Artistes</h2>
        {% for artiste in oeuvre.artistes %}
            <a href="{{ path('app_artiste_show', {'id': artiste.id}) }}">{{ artiste.pseudo }}</a>
        {% else %}
            <p>Anonyme</p>
        {% endfor %}
        <br> 
        <h2>Photos</h2>
            <div class="row">
                {% for photo in oeuvre.photos %}
                    {% if photo.nomFichier %}
                        <div class="col-md-3 mb-3">
                            <img src="{{ asset(photo.nomFichier) }}" class="img-fluid rounded" alt="{{ oeuvre.titre }}" style="height:200px; width:100%; object-fit:cover">
                            <small>{{ photo.datePriseVue|date('d/m/Y') }}</small>
                        </div>
                    {% endif %}
                {% else %}
                    <p>Aucune photo.</p>
                {% endfor %}
            </div>

    <a href="{{ path('app_oeuvre_index') }}">Retour</a>

    {% if is_granted('ROLE_USER') %}
        <a href="{{ path('app_oeuvre_edit', {'id': oeuvre.id}) }}">Modifier</a>
    {% endif %}
{% endblock %}
