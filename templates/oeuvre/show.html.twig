{% extends 'base.html.twig' %}

{% block title %}Oeuvre{% endblock %}

{% block body %}
    <h1>Oeuvre</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ oeuvre.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ oeuvre.titre }}</td>
            </tr>
            <tr>
                <th>DateCreation</th>
                <td>{{ oeuvre.dateCreation ? oeuvre.dateCreation|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ oeuvre.description }}</td>
            </tr>
            <tr>
                <th>EstDetruit</th>
                <td>{{ oeuvre.estDetruit ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <h2>Artistes</h2>
        {% for artiste in oeuvre.artistes %}
            <a href="{{ path('app_artiste_show', {'id': artiste.id}) }}">{{ artiste.pseudo }}</a>
        {% else %}
            <p>Anonyme</p>
        {% endfor %}
        <br> 
    <h2>Photos</h2>
        <div class="row">
            {% for photo in oeuvre.photos %}
                {% if photo.nomFichier %}
                    <div class="col-md-3 mb-3">
                        <img src="{{ asset(photo.nomFichier) }}" class="img-fluid rounded" alt="{{ oeuvre.titre }}" style="height:200px; width:100%; object-fit:cover; cursor:pointer" data-bs-toggle="modal" data-bs-target="#modalPhoto{{ photo.id }}">
                        <small>{{ photo.datePriseVue|date('d/m/Y') }}</small>
                    </div>

                    <div class="modal fade" id="modalPhoto{{ photo.id }}" tabindex="-1">
                        <div class="modal-dialog modal-lg modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-body p-0">
                                    <img src="{{ asset(photo.nomFichier) }}" class="img-fluid w-100" alt="{{ oeuvre.titre }}">
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% else %}
                <p>Aucune photo.</p>
            {% endfor %}
        </div>

    <a href="{{ path('app_oeuvre_index') }}">Retour</a>

    {% if is_granted('ROLE_USER') %}
        <a href="{{ path('app_oeuvre_edit', {'id': oeuvre.id}) }}">Modifier</a>
    {% endif %}
{% endblock %}
