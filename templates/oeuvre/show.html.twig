{% extends 'base.html.twig' %}

{% block title %}Oeuvre{% endblock %}

{% block body %}
    <h1>Oeuvre</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ oeuvre.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ oeuvre.titre }}</td>
            </tr>
            <tr>
                <th>DateCreation</th>
                <td>{{ oeuvre.dateCreation ? oeuvre.dateCreation|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ oeuvre.description }}</td>
            </tr>
            <tr>
                <th>EstDetruit</th>
                <td>{{ oeuvre.estDetruit ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <h2>Artistes</h2>
        {% for artiste in oeuvre.artistes %}
            <a href="{{ path('app_artiste_show', {'id': artiste.id}) }}">{{ artiste.pseudo }}</a>
        {% else %}
            <p>Anonyme</p>
        {% endfor %}
        <br> 

    <a href="{{ path('app_oeuvre_index') }}">back to list</a>

    {% if is_granted('ROLE_USER') %}
        <a href="{{ path('app_oeuvre_edit', {'id': oeuvre.id}) }}">edit</a>

        {{ include('oeuvre/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}
