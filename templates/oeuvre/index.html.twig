{% extends 'base.html.twig' %}

{% block title %}Oeuvre index{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Oeuvre index</h1>

        {% if is_granted('ROLE_USER') %}
            <a href="{{ path('app_oeuvre_new') }}" class="btn btn-success mb-3">Ajouter une oeuvre</a>
        {% endif %}

        <div class="row">
            {% for oeuvre in oeuvres %}
                {% set photo = oeuvre.photos|first %}
                <div class="col-md-4 mb-4">
                    <div class="card">
                        {% if oeuvre.photos|length > 0 %}
                            <div id="carousel{{ oeuvre.id }}" class="carousel slide">
                                <div class="carousel-inner">
                                    {% for photo in oeuvre.photos %}
                                        {% if photo.nomFichier %}
                                            <div class="carousel-item {{ loop.first ? 'active' : '' }}">
                                                <img src="{{ asset(photo.nomFichier) }}" class="d-block w-100" alt="{{ oeuvre.titre }}" style="height:200px; object-fit:cover">
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                {% if oeuvre.photos|length > 1 %}
                                    <button class="carousel-control-prev" type="button" data-bs-target="#carousel{{ oeuvre.id }}" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon"></span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#carousel{{ oeuvre.id }}" data-bs-slide="next">
                                        <span class="carousel-control-next-icon"></span>
                                    </button>
                                {% endif %}
                            </div>
                        {% endif %}
                        <div class="card-body">
                            <h5 class="card-title">{{ oeuvre.titre }}</h5>
                            {% if oeuvre.estDetruit %}
                                <span class="badge bg-danger">Détruite</span>
                            {% endif %}
                            <p class="card-text">
                                {% for artiste in oeuvre.artistes %}{{ artiste.pseudo }}{% if not loop.last %}, {% endif %}{% endfor %}
                            </p>
                            <a href="{{ path('app_oeuvre_show', {'id': oeuvre.id}) }}" class="btn btn-primary">Détails</a>
                            {% if is_granted('ROLE_USER') %}
                                <a href="{{ path('app_oeuvre_edit', {'id': oeuvre.id}) }}" class="btn btn-warning">Modifier</a>
                                {% if not oeuvre.estDetruit %}
                                    <form method="post" action="{{ path('app_oeuvre_detruire', {'id': oeuvre.id}) }}" class="d-inline">
                                        <button class="btn btn-secondary">Détruite</button>
                                    </form>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <p>Pas d'oeuvres</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
