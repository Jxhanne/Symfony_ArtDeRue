{% extends 'base.html.twig' %}

{% block title %}Oeuvre index{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Oeuvre index</h1>

        {% if is_granted('ROLE_USER') %}
            <a href="{{ path('app_oeuvre_new') }}" class="btn btn-success mb-3">Ajouter une oeuvre</a>
        {% endif %}

        <div class="row">
            {% for oeuvre in oeuvres %}
                {% set photo = oeuvre.photos|first %}
                <div class="col-md-4 mb-4">
                    <div class="card">
                        {% if photo and photo.nomFichier %}
                            <img src="{{ asset(photo.nomFichier) }}" class="card-img-top" alt="{{ oeuvre.titre }}" style="height:200px; object-fit:cover">
                        {% endif %}
                        <div class="card-body">
                            <h5 class="card-title">{{ oeuvre.titre }}</h5>
                            <p class="card-text">
                                {% for artiste in oeuvre.artistes %}{{ artiste.pseudo }}{% if not loop.last %}, {% endif %}{% endfor %}
                            </p>
                            <a href="{{ path('app_oeuvre_show', {'id': oeuvre.id}) }}" class="btn btn-primary">Détails</a>
                            {% if is_granted('ROLE_USER') %}
                                <a href="{{ path('app_oeuvre_edit', {'id': oeuvre.id}) }}" class="btn btn-warning">Modifier</a>
                                {{ include('oeuvre/_delete_form.html.twig') }}
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <p>Pas d'oeuvres</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
