{% extends 'base.html.twig' %}

{% block title %}Photo index{% endblock %}

{% block body %}
    <h1>Photo index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>DatePriseVue</th>
                <th>NomFichier</th>
                <th>EtatOeuvre</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for photo in photos %}
            <tr>
                <td>{{ photo.id }}</td>
                <td>{{ photo.datePriseVue ? photo.datePriseVue|date('Y-m-d') : '' }}</td>
                <td>
                    {% if photo.nomFichier %}
                        <img src="{{ asset(photo.nomFichier) }}" width="100">
                    {% endif %}
                </td>
                <td>{{ photo.etatOeuvre }}</td>
                <td>
                    <a href="{{ path('app_photo_show', {'id': photo.id}) }}">Voir</a>
                    {% if is_granted('ROLE_USER') %}
                        <a href="{{ path('app_photo_edit', {'id': photo.id}) }}">Modifier</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Pas de photo</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if is_granted('ROLE_USER') %}
        <a href="{{ path('app_photo_new') }}">Ajouter une photo</a>
    {% endif %}
{% endblock %}
