{% extends 'base.html.twig' %}

{% block title %}Photo{% endblock %}

{% block body %}
    <h1>Photo</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ photo.id }}</td>
            </tr>
            <tr>
                <th>DatePriseVue</th>
                <td>{{ photo.datePriseVue ? photo.datePriseVue|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Photo</th>
                {% if photo.nomFichier %}
                    <img src="{{ asset(photo.nomFichier) }}" width="200">
                {% endif %}
            </tr>
            <tr>
                <th>EtatOeuvre</th>
                <td>{{ photo.etatOeuvre }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_photo_index') }}">back to list</a>

    {% if is_granted('ROLE_USER') %}
        <a href="{{ path('app_photo_edit', {'id': photo.id}) }}">edit</a>

        {{ include('photo/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}
