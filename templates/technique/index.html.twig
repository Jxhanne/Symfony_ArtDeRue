{% extends 'base.html.twig' %}

{% block title %}Technique index{% endblock %}

{% block body %}
    <h1>Technique index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for technique in techniques %}
            <tr>
                <td>{{ technique.id }}</td>
                <td>{{ technique.nom }}</td>
                <td>
                    <a href="{{ path('app_technique_show', {'id': technique.id}) }}">Voir</a>
                    {% if is_granted('ROLE_USER') %}
                        <a href="{{ path('app_technique_edit', {'id': technique.id}) }}">Modifier</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Pas de technique</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if is_granted('ROLE_USER') %}
        <a href="{{ path('app_technique_new') }}">Ajouter une nouvelle technique</a>
    {% endif %}
{% endblock %}
