{% extends 'base.html.twig' %}

{% block title %}Artiste index{% endblock %}

{% block body %}
    <h1>Artiste index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Pseudo</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Nationalite</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for artiste in artistes %}
            <tr>
                <td>{{ artiste.id }}</td>
                <td>{{ artiste.pseudo }}</td>
                <td>{{ artiste.nom }}</td>
                <td>{{ artiste.description }}</td>
                <td>{{ artiste.nationalite }}</td>
                <td>
                    <a href="{{ path('app_artiste_show', {'id': artiste.id}) }}">Voir</a>
                    {% if is_granted('ROLE_USER') %}
                        <a href="{{ path('app_artiste_edit', {'id': artiste.id}) }}">Modifier</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Pas d'artiste</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if is_granted('ROLE_USER') %}
        <a href="{{ path('app_artiste_new') }}">Ajouter un artiste</a>
    {% endif %}
{% endblock %}
