{% extends 'base.html.twig' %}

{% block title %}Artiste{% endblock %}

{% block body %}
    <h1>Artiste</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ artiste.id }}</td>
            </tr>
            <tr>
                <th>Pseudo</th>
                <td>{{ artiste.pseudo }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ artiste.nom }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ artiste.description }}</td>
            </tr>
            <tr>
                <th>Nationalite</th>
                <td>{{ artiste.nationalite }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_artiste_index') }}">Retour</a>

    {% if is_granted('ROLE_USER') %}
        <a href="{{ path('app_artiste_edit', {'id': artiste.id}) }}">Modifier</a>

        {{ include('artiste/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}
